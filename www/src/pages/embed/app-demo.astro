---
/**
 * The hero demo, on a page of its own so the landing can embed it in a frame.
 *
 * It lives apart because the desktop app ships Tailwind's preflight: loading
 * the app's stylesheet into the landing page would reset the landing's own
 * hand-written CSS. A frame keeps the two stylesheets from ever meeting, and
 * has a second payoff — the demo is safe to leave interactive, so a visitor
 * can change tabs and poke at the tree instead of only watching.
 *
 * Not linked from anywhere and marked `noindex`: it is a part, not a page.
 */
import "../../styles/app-theme.css";
import "../../../../desktop/src/globals.css";
import AppDemo from "../../components/landing/demo/AppDemo";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Warpforge demo</title>
    <style>
      html,
      body {
        height: 100%;
        margin: 0;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <AppDemo client:only="react" />
  </body>
</html>
