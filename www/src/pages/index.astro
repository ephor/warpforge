---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import { config } from "virtual:nimbus/config";
import ForgeDemo from "@/components/landing/ForgeDemo.astro";
import ClaimPanels from "@/components/landing/ClaimPanels.astro";

const harnesses = [
  { name: "Claude Code", logo: "/logos/claude-ai-icon.svg" },
  { name: "Codex", logo: "/logos/codex_dark.svg" },
  { name: "OpenCode", logo: "/logos/openCode_dark.svg" },
  { name: "Qwen Code", logo: "/logos/qwen_dark.svg" },
  { name: "Goose", logo: "/logos/goose_dark.png" },
  { name: "Junie", logo: "/logos/junie.svg" },
  { name: "Cursor", logo: "/logos/cursor_dark.svg" },
  { name: "Pi", logo: "/logos/pi_dark.svg" },
];

const specs = [
  ["Runs", "On your machine. No account, no API key of ours."],
  ["Harnesses", "Eight, using the logins you already have."],
  ["Agent tools", "31 over MCP — runtime, memory, tasks, delegation."],
  ["Editor", "Go to definition, references, rename, hover, diagnostics."],
  ["License", "MIT. Fork the whole thing."],
];
---

<!doctype html>
<html lang={config.locale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <NimbusHead title={config.title} description={config.description} />
  </head>
  <body>
    <div class="wf">
      <header class="nav">
        <div class="shell nav-in">
          <a href="/" class="logo"><span class="mark" aria-hidden="true"></span>Warpforge</a>
          <nav class="nav-links" aria-label="Primary">
            <a href="/overview/">Docs</a>
            <a href="/concepts/memory/">Memory</a>
            <a href="/reference/mcp-tools/">Tools</a>
          </nav>
          <div class="nav-act">
            <a
              href="https://github.com/ephor/warpforge"
              class="ghost-link"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"><Icon name="ph:github-logo" size={16} /></a
            >
            <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-sm">Download</a>
          </div>
        </div>
      </header>

      <main id="main-content">
        <!-- Hero: the claim, then the thing itself -->
        <section class="hero">
          <div class="shell">
            <p class="eyebrow">
              <span class="pulse" aria-hidden="true"></span>Open source · Local-first · macOS
            </p>
            <h1>
              Your agents don't share<br />a workspace. Now they do.
            </h1>
            <p class="lede">
              Warpforge is an <b>agentic development environment</b> — one place where several
              coding agents run in parallel, on real services and real ports, and everything they
              write arrives as a diff you review. Not a wrapper around one model.
            </p>
            <div class="cta">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={16} />Download for macOS
              </a>
              <a href="/overview/" class="btn btn-lg btn-ghost">
                Read the docs<Icon name="ph:arrow-right" size={16} />
              </a>
            </div>
            <p class="micro">Apple Silicon · Signed &amp; notarized · Homebrew: <code>brew install --cask ephor/tap/warpforge</code></p>
          </div>

          <div class="shell shell-wide demo-wrap">
            <ForgeDemo />
            <p class="demo-cap">
              A real run, not a recording: one task, a Claude lead that hands the test suite to Codex,
              and one diff at the end of it. Click around — it is the app.
            </p>
          </div>
        </section>

        <!-- Harness strip -->
        <section class="strip">
          <div class="shell strip-in">
            <span class="strip-label">Brings its own agents</span>
            <ul class="strip-logos">
              {
                harnesses.map((h) => (
                  <li>
                    <img src={h.logo} alt="" width="18" height="18" loading="lazy" />
                    {h.name}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <ClaimPanels />

        <!-- Spec sheet -->
        <section class="specs">
          <div class="shell">
            <dl>
              {
                specs.map(([k, v]) => (
                  <div class="spec">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <!-- Close -->
        <section class="close">
          <div class="shell close-in">
            <h2>Stop being the integration layer.</h2>
            <p>Free, open source, and it never leaves your machine.</p>
            <div class="cta cta-center">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={16} />Download for macOS
              </a>
              <a href="https://github.com/ephor/warpforge" class="btn btn-lg btn-ghost" target="_blank" rel="noopener">
                <Icon name="ph:github-logo" size={16} />Source
              </a>
            </div>
            <p class="micro">Apple Silicon today · Windows &amp; Linux are an opt-in preview</p>
          </div>
        </section>
      </main>

      <footer class="foot">
        <div class="shell foot-in">
          <a href="/" class="logo logo-sm"><span class="mark" aria-hidden="true"></span>Warpforge</a>
          <nav aria-label="Footer">
            <a href="/overview/">Docs</a>
            <a href="https://github.com/ephor/warpforge" target="_blank" rel="noopener">GitHub</a>
            <a href="https://github.com/ephor/warpforge/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a>
            <a href="https://github.com/ephor/warpforge/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* The desktop app's own tokens, as the HSL triplets in
     `desktop/src/globals.css` — same values, so the page and the product read
     as one thing. Fixed dark: this page does not render the docs chrome and so
     does not follow the docs theme toggle. */
  .wf {
    --background: 120 3% 8%;
    --foreground: 36 23% 91%;
    --card: 120 3% 6%;
    --muted-foreground: 34 7% 62%;
    --border: 72 5% 20%;
    --primary: 20 73% 70%;
    --primary-foreground: 20 40% 10%;
    --secondary: 75 5% 15%;
    --ring: 20 73% 70%;
    --radius: 0.375rem;

    --bg: hsl(var(--background));
    --panel: hsl(var(--card));
    --line: hsl(var(--border) / 0.55);
    --line-2: hsl(var(--border));
    --fg: hsl(var(--foreground));
    --mut: hsl(var(--muted-foreground));
    --faint: hsl(var(--muted-foreground) / 0.7);
    --accent: hsl(var(--primary));

    background: var(--bg);
    color: var(--fg);
    font-family: "Inter Variable", Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  .shell {
    max-width: 60rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .shell-wide {
    max-width: 72rem;
  }
  code {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.9em;
  }

  /* ---- nav ---- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--line);
    background: hsl(var(--background) / 0.86);
    backdrop-filter: blur(10px);
  }
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-decoration: none;
  }
  .mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }
  .nav-links {
    display: none;
    gap: 1.5rem;
    font-size: 0.8125rem;
  }
  .nav-links a,
  .foot nav a {
    color: var(--mut);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover,
  .foot nav a:hover {
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
  .nav-act {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ghost-link {
    display: inline-flex;
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .ghost-link:hover {
    color: var(--fg);
  }

  /* ---- buttons, per lib/buttonVariants.ts ----
     The app's buttons only transition colour: no lift, no scale. Hover on the
     primary variant is the same hue at 90%, not a second, darker one. Sizes
     and the focus ring are its `default` / `lg` / `sm` variants. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover {
    background: hsl(var(--primary) / 0.9);
  }
  .btn:focus-visible,
  .ghost-link:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 1px var(--bg),
      0 0 0 3px hsl(var(--ring));
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .btn-sm {
    height: 1.75rem;
    padding-inline: 0.5rem;
    font-size: 0.75rem;
  }
  .btn-lg {
    height: 2.5rem;
    padding-inline: 1.5rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--mut);
    border-color: hsl(var(--border));
  }
  .btn-ghost:hover {
    background: hsl(var(--secondary));
    color: var(--fg);
  }

  /* ---- hero ---- */
  .hero {
    padding-top: 4.5rem;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.6875rem;
    color: var(--mut);
  }
  .pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 hsl(var(--primary) / 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70%,
    100% {
      box-shadow: 0 0 0 0.4rem transparent;
    }
  }
  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.1rem, 5.4vw, 3.4rem);
    font-weight: 640;
    line-height: 1.07;
    letter-spacing: -0.032em;
  }
  .lede {
    max-width: 36rem;
    margin: 0 auto 1.9rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mut);
  }
  .lede b {
    color: var(--fg);
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .micro {
    margin: 0;
    font-size: 0.75rem;
    color: var(--faint);
  }
  .micro code {
    color: var(--mut);
  }

  .demo-wrap {
    margin-top: 3.25rem;
  }
  .demo-cap {
    margin: 0.9rem 0 0;
    font-size: 0.8125rem;
    color: var(--faint);
    text-align: center;
  }

  /* ---- harness strip ---- */
  .strip {
    margin-top: 5rem;
    border-block: 1px solid var(--line);
    background: var(--panel);
  }
  .strip-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }
  .strip-label {
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .strip-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip-logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--mut);
  }
  .strip-logos img {
    width: 1.125rem;
    height: 1.125rem;
    object-fit: contain;
    opacity: 0.9;
  }

  /* ---- spec sheet ---- */
  .specs {
    border-bottom: 1px solid var(--line);
    padding-block: 3rem;
  }
  .specs dl {
    margin: 0;
  }
  .spec {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding-block: 0.7rem;
    border-top: 1px dashed var(--line);
    font-size: 0.875rem;
  }
  .spec:first-child {
    border-top: 0;
  }
  @media (min-width: 620px) {
    .spec {
      grid-template-columns: 9rem 1fr;
      gap: 1rem;
    }
  }
  .spec dt {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--faint);
    padding-top: 0.1rem;
  }
  .spec dd {
    margin: 0;
    color: var(--mut);
  }

  /* ---- close ---- */
  .close {
    padding-block: 5.5rem;
  }
  .close-in {
    text-align: center;
  }
  .close h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 4.4vw, 2.7rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .close > .shell > p {
    margin: 0 0 1.7rem;
    color: var(--mut);
  }
  .cta-center {
    justify-content: center;
  }

  /* ---- footer ---- */
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }
  .foot-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  @media (min-width: 620px) {
    .foot-in {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .logo-sm {
    font-size: 0.8125rem;
    color: var(--mut);
  }
  .foot nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .pulse {
      transition: none;
      animation: none;
    }
  }
</style>
