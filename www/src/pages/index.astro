---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import { config } from "virtual:nimbus/config";
import ForgeDemo from "@/components/landing/ForgeDemo.astro";

const harnesses = [
  { name: "Claude Code", logo: "/logos/claude-ai-icon.svg" },
  { name: "Codex", logo: "/logos/codex_dark.svg" },
  { name: "OpenCode", logo: "/logos/openCode_dark.svg" },
  { name: "Qwen Code", logo: "/logos/qwen_dark.svg" },
  { name: "Goose", logo: "/logos/goose_dark.png" },
  { name: "Junie", logo: "/logos/junie.svg" },
  { name: "Cursor", logo: "/logos/cursor_dark.svg" },
  { name: "Pi", logo: "/logos/pi_dark.svg" },
];

/** Panels: each states a claim, then shows the surface that backs it. */
const panels = [
  {
    kicker: "Memory",
    title: "They stop forgetting what you told the other one.",
    body: "Claude Code reads CLAUDE.md. Codex reads AGENTS.md. Warpforge gives them one store instead — decisions, gotchas, preferences — shared across every harness, on your disk. A dreaming pass checks it against the code and proposes cleanups; it never rewrites what your agents believe on its own.",
    href: "/concepts/memory/",
    linkText: "How memory works",
  },
  {
    kicker: "Runtime",
    title: "The agent can read the log it just broke.",
    body: "Services start in dependency order on ports that never collide, and the agent gets them as tools: list what's running, grep a service log, restart it, watch it come back. It fixes its own mistake before the diff reaches you.",
    href: "/reference/mcp-tools/",
    linkText: "All 31 tools",
  },
  {
    kicker: "Review",
    title: "An IDE's git, not a commit box.",
    body: "A real branch tree with native context menus. Rebase onto a branch without checking it out. Hunk-level accept and reject, inline edits, amend that prefills. Every operation runs in the task's own worktree — the diff you reviewed is the diff you committed.",
    href: "/guides/git-in-warpforge/",
    linkText: "Git in Warpforge",
  },
];

const specs = [
  ["Runs", "On your machine. No account, no API key of ours."],
  ["Harnesses", "Eight, using the logins you already have."],
  ["Agent tools", "31 over MCP — runtime, memory, tasks, delegation."],
  ["Editor", "Go to definition, references, rename, hover, diagnostics."],
  ["License", "MIT. Fork the whole thing."],
];
---

<!doctype html>
<html lang={config.locale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <NimbusHead title={config.title} description={config.description} />
  </head>
  <body>
    <div class="wf">
      <header class="nav">
        <div class="shell nav-in">
          <a href="/" class="logo"><span class="mark" aria-hidden="true"></span>Warpforge</a>
          <nav class="nav-links" aria-label="Primary">
            <a href="/overview/">Docs</a>
            <a href="/concepts/memory/">Memory</a>
            <a href="/reference/mcp-tools/">Tools</a>
          </nav>
          <div class="nav-act">
            <a
              href="https://github.com/ephor/warpforge"
              class="ghost-link"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"><Icon name="ph:github-logo" size={17} /></a
            >
            <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-sm">Download</a>
          </div>
        </div>
      </header>

      <main id="main-content">
        <!-- Hero: the claim, then the thing itself -->
        <section class="hero">
          <div class="shell">
            <p class="eyebrow">
              <span class="pulse" aria-hidden="true"></span>Open source · Local-first · macOS
            </p>
            <h1>
              Your agents don't share<br />a workspace. Now they do.
            </h1>
            <p class="lede">
              Warpforge is an <b>agentic development environment</b> — one place where several
              coding agents run in parallel, on real services and real ports, and everything they
              write arrives as a diff you review. Not a wrapper around one model.
            </p>
            <div class="cta">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={17} />Download for macOS
              </a>
              <a href="/overview/" class="btn btn-lg btn-ghost">
                Read the docs<Icon name="ph:arrow-right" size={15} />
              </a>
            </div>
            <p class="micro">Apple Silicon · Signed &amp; notarized · Homebrew: <code>brew install --cask ephor/tap/warpforge</code></p>
          </div>

          <div class="shell shell-wide demo-wrap">
            <ForgeDemo />
            <p class="demo-cap">
              One task. A Claude Code lead, a Codex sub-agent, an opencode sub-agent — and one diff
              at the end of it.
            </p>
          </div>
        </section>

        <!-- Harness strip -->
        <section class="strip">
          <div class="shell strip-in">
            <span class="strip-label">Brings its own agents</span>
            <ul class="strip-logos">
              {
                harnesses.map((h) => (
                  <li>
                    <img src={h.logo} alt="" width="18" height="18" loading="lazy" />
                    {h.name}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <!-- Claim panels -->
        {
          panels.map((p, i) => (
            <section class="panel">
              <div class="shell panel-in">
                <span class="idx" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="panel-copy">
                  <span class="kicker">{p.kicker}</span>
                  <h2>{p.title}</h2>
                  <p>{p.body}</p>
                  <a href={p.href} class="arrow-link">
                    {p.linkText}
                    <Icon name="ph:arrow-right" size={14} />
                  </a>
                </div>
              </div>
            </section>
          ))
        }

        <!-- Spec sheet -->
        <section class="specs">
          <div class="shell">
            <dl>
              {
                specs.map(([k, v]) => (
                  <div class="spec">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <!-- Close -->
        <section class="close">
          <div class="shell close-in">
            <h2>Stop being the integration layer.</h2>
            <p>Free, open source, and it never leaves your machine.</p>
            <div class="cta cta-center">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={17} />Download for macOS
              </a>
              <a href="https://github.com/ephor/warpforge" class="btn btn-lg btn-ghost" target="_blank" rel="noopener">
                <Icon name="ph:github-logo" size={16} />Source
              </a>
            </div>
            <p class="micro">Apple Silicon today · Windows &amp; Linux are an opt-in preview</p>
          </div>
        </section>
      </main>

      <footer class="foot">
        <div class="shell foot-in">
          <a href="/" class="logo logo-sm"><span class="mark" aria-hidden="true"></span>Warpforge</a>
          <nav aria-label="Footer">
            <a href="/overview/">Docs</a>
            <a href="https://github.com/ephor/warpforge" target="_blank" rel="noopener">GitHub</a>
            <a href="https://github.com/ephor/warpforge/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a>
            <a href="https://github.com/ephor/warpforge/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* Fixed dark, matching the desktop app's own palette. This page does not
     render the docs chrome, so it does not follow the docs theme toggle. */
  .wf {
    --bg: #121311;
    --panel: #171816;
    --line: #26271f;
    --line-2: #333630;
    --fg: #ede9e3;
    --mut: #a7a199;
    --faint: #6f6a62;
    --accent: #eaa07b;
    --accent-2: #e3804f;
    --ink: #2a1509;

    background: var(--bg);
    color: var(--fg);
    font-family: "Inter Variable", Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  .shell {
    max-width: 60rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .shell-wide {
    max-width: 72rem;
  }
  code {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.9em;
  }

  /* ---- nav ---- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
  }
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-decoration: none;
  }
  .mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }
  .nav-links {
    display: none;
    gap: 1.5rem;
    font-size: 0.8125rem;
  }
  .nav-links a,
  .foot nav a {
    color: var(--mut);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-links a:hover,
  .foot nav a:hover {
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
  .nav-act {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ghost-link {
    display: inline-flex;
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .ghost-link:hover {
    color: var(--fg);
  }

  /* ---- buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .btn:hover {
    background: var(--accent-2);
    transform: translateY(-1px);
  }
  .btn-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
  }
  .btn-lg {
    padding: 0.65rem 1.2rem;
    font-size: 0.9375rem;
    border-radius: 0.625rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--mut);
    border: 1px solid var(--line-2);
  }
  .btn-ghost:hover {
    background: transparent;
    color: var(--fg);
    border-color: var(--faint);
  }

  /* ---- hero ---- */
  .hero {
    padding-top: 4.5rem;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.6875rem;
    color: var(--mut);
  }
  .pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--accent) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70%,
    100% {
      box-shadow: 0 0 0 0.4rem transparent;
    }
  }
  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.1rem, 5.4vw, 3.4rem);
    font-weight: 640;
    line-height: 1.07;
    letter-spacing: -0.032em;
  }
  .lede {
    max-width: 36rem;
    margin: 0 auto 1.9rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mut);
  }
  .lede b {
    color: var(--fg);
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .micro {
    margin: 0;
    font-size: 0.75rem;
    color: var(--faint);
  }
  .micro code {
    color: var(--mut);
  }

  .demo-wrap {
    margin-top: 3.25rem;
  }
  .demo-cap {
    margin: 0.9rem 0 0;
    font-size: 0.8125rem;
    color: var(--faint);
    text-align: center;
  }

  /* ---- harness strip ---- */
  .strip {
    margin-top: 5rem;
    border-block: 1px solid var(--line);
    background: var(--panel);
  }
  .strip-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }
  .strip-label {
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .strip-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip-logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--mut);
  }
  .strip-logos img {
    width: 1.125rem;
    height: 1.125rem;
    object-fit: contain;
    opacity: 0.9;
  }

  /* ---- claim panels ---- */
  .panel {
    border-bottom: 1px solid var(--line);
  }
  .panel-in {
    display: grid;
    gap: 1rem;
    padding-block: 4rem;
  }
  @media (min-width: 720px) {
    .panel-in {
      grid-template-columns: 4rem 1fr;
      gap: 0;
    }
  }
  .idx {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--line-2);
    padding-top: 0.35rem;
  }
  .panel-copy {
    max-width: 40rem;
  }
  .kicker {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .panel h2 {
    margin: 0 0 0.7rem;
    font-size: clamp(1.35rem, 2.7vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .panel p {
    margin: 0 0 1rem;
    font-size: 0.9688rem;
    line-height: 1.65;
    color: var(--mut);
  }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .arrow-link:hover {
    color: var(--accent-2);
  }

  /* ---- spec sheet ---- */
  .specs {
    border-bottom: 1px solid var(--line);
    padding-block: 3rem;
  }
  .specs dl {
    margin: 0;
  }
  .spec {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding-block: 0.7rem;
    border-top: 1px dashed var(--line);
    font-size: 0.875rem;
  }
  .spec:first-child {
    border-top: 0;
  }
  @media (min-width: 620px) {
    .spec {
      grid-template-columns: 9rem 1fr;
      gap: 1rem;
    }
  }
  .spec dt {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--faint);
    padding-top: 0.1rem;
  }
  .spec dd {
    margin: 0;
    color: var(--mut);
  }

  /* ---- close ---- */
  .close {
    padding-block: 5.5rem;
  }
  .close-in {
    text-align: center;
  }
  .close h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 4.4vw, 2.7rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .close > .shell > p {
    margin: 0 0 1.7rem;
    color: var(--mut);
  }
  .cta-center {
    justify-content: center;
  }

  /* ---- footer ---- */
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }
  .foot-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  @media (min-width: 620px) {
    .foot-in {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .logo-sm {
    font-size: 0.8125rem;
    color: var(--mut);
  }
  .foot nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .pulse {
      transition: none;
      animation: none;
    }
  }
</style>
