---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import { config } from "virtual:nimbus/config";
import ForgeDemo from "@/components/landing/ForgeDemo.astro";
import ClaimPanels from "@/components/landing/ClaimPanels.astro";
import ThemeSwitcher from "@/components/landing/ThemeSwitcher.tsx";
import { THEMES } from "@app/lib/themes";
import { DEFAULT_THEME_ID, THEME_STORAGE_KEY } from "@/lib/landing-theme";

const themes = Object.fromEntries(THEMES.map((t) => [t.id, { colors: t.colors, mode: t.mode }]));
const defaultTheme = themes[DEFAULT_THEME_ID];

/* Built as CSS text rather than passed through `define:vars`: that directive
   stamps the variables onto every element it renders as inline styles, which
   nothing inheriting from `:root` can override — including the script below. */
const rootTokens = `:root {\n${Object.entries(defaultTheme.colors)
  .map(([name, value]) => `  --${name}: ${value};`)
  .join("\n")}\n  --radius: 0.375rem;\n}`;

const harnesses = [
  { name: "Claude Code", logo: "/logos/claude-ai-icon.svg" },
  { name: "Codex", logo: "/logos/codex_dark.svg" },
  { name: "OpenCode", logo: "/logos/openCode_dark.svg" },
  { name: "Qwen Code", logo: "/logos/qwen_dark.svg" },
  { name: "Goose", logo: "/logos/goose_dark.png" },
  { name: "Junie", logo: "/logos/junie.svg" },
  { name: "Cursor", logo: "/logos/cursor_dark.svg" },
  { name: "Pi", logo: "/logos/pi_dark.svg" },
];

/* The page's factual floor, as five answers rather than five sentences: the
   figure carries the point and the line under it says what it means. */
const specs = [
  ["Local", "Runs on your machine. No account, no API key of ours."],
  ["8", "Harnesses, on the logins you already have."],
  ["31", "Agent tools over MCP — runtime, memory, tasks, delegation."],
  ["LSP", "Go to definition, references, rename, hover, diagnostics."],
  ["MIT", "Licensed. Fork the whole thing."],
];
---

<!doctype html>
<html lang={config.locale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <NimbusHead title={config.title} description={config.description} />

    {/*
      Tokens on `:root` rather than on `.wf`, so the picker — and the script
      below — can set every one of them in a single place. Names and meanings
      are the app's, from `desktop/src/lib/themes.ts`.
    */}
    {/* The default theme as a plain `:root` rule, so the page is fully painted
        with no script at all; the script below overrides it inline when
        another theme has been chosen. */}
    <style is:global set:html={rootTokens}></style>
    {/* The palettes travel as data rather than through `define:vars`: that
        injects names the type checker cannot see, and every reference to them
        is reported as undefined. */}
    <script
      type="application/json"
      id="wf-themes"
      set:html={JSON.stringify({ defaultId: DEFAULT_THEME_ID, storageKey: THEME_STORAGE_KEY, themes })}
    />
    <script is:inline>
      // Paint the chosen theme before the first frame. Without this the page
      // renders in the default palette and only corrects once the picker has
      // hydrated, which is a visible flash of the wrong colours.
      (() => {
        const data = JSON.parse(document.getElementById("wf-themes").textContent);
        let id = data.defaultId;
        try {
          id = localStorage.getItem(data.storageKey) || data.defaultId;
        } catch {
          /* Storage unavailable — the default is a fine starting point. */
        }
        const theme = data.themes[id] || data.themes[data.defaultId];
        const root = document.documentElement;
        for (const [name, value] of Object.entries(theme.colors)) {
          root.style.setProperty(`--${name}`, value);
        }
        root.dataset.theme = id;
        root.classList.toggle("dark", theme.mode === "dark");
      })();
    </script>
  </head>
  <body>
    <div class="wf">
      <header class="nav">
        <div class="shell nav-in">
          <a href="/" class="logo" aria-label="Warpforge — home">Warp<span>forge</span></a>
          <nav class="nav-links" aria-label="Primary">
            <a href="/concepts/orchestration/">Orchestration</a>
            <a href="/concepts/memory/">Memory</a>
            <a href="/guides/projects-and-runtime/">Runtime</a>
          </nav>
          <div class="nav-act">
            <ThemeSwitcher client:load />
            <a
              href="https://github.com/warpforgehq/warpforge"
              class="ghost-link"
              target="_blank"
              rel="noopener"
              aria-label="GitHub"><Icon name="ph:github-logo" size={16} /></a
            >
          </div>
        </div>
      </header>

      <main id="main-content">
        <!-- Hero: the claim, then the thing itself -->
        <section class="hero">
          <div class="shell">
            <p class="eyebrow">
              <span class="pulse" aria-hidden="true"></span>Open source · Local-first · macOS
            </p>
            <h1>
              Your agents don't share<br />a workspace. Now they do.
            </h1>
            <p class="lede">
              Warpforge is an <b>agentic development environment</b> — one place where several
              coding agents run in parallel, on real services and real ports, and everything they
              write arrives as a diff you review. Not a wrapper around one model.
            </p>
            <div class="cta">
              <a href="https://github.com/warpforgehq/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={16} />Download for macOS
              </a>
              <a href="/overview/" class="btn btn-lg btn-ghost">
                Read the docs<Icon name="ph:arrow-right" size={16} />
              </a>
            </div>
            <p class="micro">Apple Silicon · Signed &amp; notarized · Homebrew: <code>brew install --cask ephor/tap/warpforge</code></p>
          </div>

          <div class="shell shell-wide demo-wrap">
            <ForgeDemo />
            <p class="demo-cap">Live demo — interactive. One task, delegated across agents, one diff to review.</p>
          </div>
        </section>

        <!-- Harness strip -->
        <section class="strip">
          <div class="shell strip-in">
            <span class="strip-label">Brings its own agents</span>
            <ul class="strip-logos">
              {
                harnesses.map((h) => (
                  <li>
                    <img src={h.logo} alt="" width="18" height="18" loading="lazy" />
                    {h.name}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <ClaimPanels />

        <!-- Spec sheet -->
        <section class="specs">
          <div class="shell">
            <dl class="spec-grid">
              {
                specs.map(([k, v]) => (
                  <div class="spec">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        <!-- Close -->
        <section class="close">
          <div class="shell close-in">
            <h2>Stop being the integration layer.</h2>
            <p>Free, open source, and it never leaves your machine.</p>
            <div class="cta cta-center">
              <a href="https://github.com/warpforgehq/warpforge/releases/latest" class="btn btn-lg">
                <Icon name="ph:apple-logo" size={16} />Download for macOS
              </a>
              <a href="https://github.com/warpforgehq/warpforge" class="btn btn-lg btn-ghost" target="_blank" rel="noopener">
                <Icon name="ph:github-logo" size={16} />Source
              </a>
            </div>
            <p class="micro">Apple Silicon today · Windows &amp; Linux are an opt-in preview</p>
          </div>
        </section>
      </main>

      <footer class="foot">
        <div class="shell foot-in">
          <a href="/" class="logo logo-sm" aria-label="Warpforge — home">Warp<span>forge</span></a>
          <nav aria-label="Footer">
            <a href="/overview/">Docs</a>
            <a href="https://github.com/warpforgehq/warpforge" target="_blank" rel="noopener">GitHub</a>
            <a href="https://github.com/warpforgehq/warpforge/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a>
            <a href="https://github.com/warpforgehq/warpforge/blob/main/LICENSE" target="_blank" rel="noopener">MIT</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* The desktop app's own tokens, as the HSL triplets in
     `desktop/src/globals.css` — same values, so the page and the product read
     as one thing. Fixed dark: this page does not render the docs chrome and so
     does not follow the docs theme toggle. */
  /* The raw tokens live on `:root` (see the global block above) so the theme
     picker's inline values reach every one of them. What is left here are the
     page's own shorthands, which resolve through `var()` at use and so follow
     whatever theme is current. `--accent` used to be one of them, meaning "the
     accent, as a colour" — the opposite of the app's `--accent`, which is a
     raw triplet. The picker wrote the triplet over it and the two things it
     painted went transparent; the shorthand is gone and those rules name
     `--primary` directly. */
  .wf {
    --bg: hsl(var(--background));
    --panel: hsl(var(--card));
    --line: hsl(var(--border) / 0.55);
    --line-2: hsl(var(--border));
    --fg: hsl(var(--foreground));
    --mut: hsl(var(--muted-foreground));
    --faint: hsl(var(--muted-foreground) / 0.7);

    background: var(--bg);
    color: var(--fg);
    font-family: "Inter Variable", Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }
  .shell {
    max-width: 60rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .shell-wide {
    max-width: 72rem;
  }
  code {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.9em;
  }

  /* ---- nav ---- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--line);
    background: hsl(var(--background) / 0.86);
    backdrop-filter: blur(10px);
  }
  /* Three tracks with equal outer columns, so the links sit on the page's
     centre line whatever the mark and the controls happen to measure.
     `space-between` only centres the middle child when both sides match. */
  .nav-in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 3.25rem;
  }
  .nav-act {
    justify-self: end;
  }
  /* The wordmark the app itself wears, in its sidebar and its task headers:
     uppercase, widely tracked, the second half in the accent. A rotated
     square and title case were this page's own invention and matched nothing
     the product shows. See `desktop/src/components/Sidebar.tsx`. */
  .logo {
    display: inline-flex;
    align-items: center;
    /* The app's stack, not the page's. Warpforge draws its chrome in the
       system UI face — SF Pro on macOS — so the wordmark rendered in the
       page's Inter was a near-miss of the thing it is supposed to be. */
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--fg);
    text-decoration: none;
    /* The tracking trails after the last letter too; pull it back so the mark
       sits flush with the edge it is aligned to. */
    margin-right: -0.2em;
  }
  .logo span {
    color: hsl(var(--primary));
  }
  .nav-links {
    display: none;
    gap: 1.5rem;
    font-size: 0.8125rem;
  }
  .nav-links a,
  .foot nav a {
    color: var(--mut);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  /* Hover lands on the accent, the way every other link on the page does —
     these were the only ones that merely brightened to the body colour. */
  .nav-links a:hover,
  .foot nav a:hover {
    color: hsl(var(--primary));
  }
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }
  .nav-act {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ghost-link {
    display: inline-flex;
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .ghost-link:hover {
    color: var(--fg);
  }

  /* ---- buttons, per lib/buttonVariants.ts ----
     The app's buttons only transition colour: no lift, no scale. Hover on the
     primary variant is the same hue at 90%, not a second, darker one. Sizes
     and the focus ring are its `default` / `lg` / `sm` variants. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover {
    background: hsl(var(--primary) / 0.9);
  }
  .btn:focus-visible,
  .ghost-link:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 1px var(--bg),
      0 0 0 3px hsl(var(--ring));
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .btn-sm {
    height: 1.75rem;
    padding-inline: 0.5rem;
    font-size: 0.75rem;
  }
  .btn-lg {
    height: 2.5rem;
    padding-inline: 1.5rem;
  }
  .btn-ghost {
    background: transparent;
    color: var(--mut);
    border-color: hsl(var(--border));
  }
  .btn-ghost:hover {
    background: hsl(var(--secondary));
    color: var(--fg);
  }

  /* ---- hero VARIANTS (uncomment one) ---- */
  /* HERO_VARIANT_A: Forge Grid
  .hero {
    position: relative; overflow: hidden; padding-top: 4.5rem; text-align: center;
    background:
      radial-gradient(800px 400px at 50% -10%, hsl(var(--primary) / 0.18), transparent 70%),
      radial-gradient(600px 300px at 85% 30%, hsl(var(--primary) / 0.1), transparent 60%),
      linear-gradient(hsl(var(--border) / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--border) / 0.12) 1px, transparent 1px),
      var(--bg);
    background-size: auto, auto, 32px 32px, 32px 32px, auto;
  }
  .hero::after { content:""; position:absolute; inset:0; background: radial-gradient(900px 500px at 50% 0%, transparent 55%, hsl(var(--background)/0.7) 95%); pointer-events:none; }
  .hero > .shell { position:relative; z-index:1; }
  */

  /* HERO_VARIANT_B: Aurora Mesh
  .hero { position:relative; overflow:hidden; padding-top:4.5rem; text-align:center; background:var(--bg); }
  .hero::before { content:""; position:absolute; inset:-20%; background: radial-gradient(500px 500px at 20% 10%, hsl(20 73% 68%/0.28), transparent 60%), radial-gradient(600px 400px at 80% 20%, hsl(25 90% 60%/0.18), transparent 60%), radial-gradient(700px 500px at 50% 85%, hsl(120 3% 18%/0.8), transparent 60%); filter:blur(28px); pointer-events:none; }
  .hero::after { content:""; position:absolute; inset:0; background:radial-gradient(900px 500px at 50% 0%, transparent 45%, hsl(var(--background)/0.55) 95%); pointer-events:none; }
  .hero > .shell { position:relative; z-index:1; }
  */

  /* HERO_VARIANT_C: Noise + ember + breathing — active */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 4.5rem;
    text-align: center;
    background:
      radial-gradient(1100px 600px at 50% -12%, hsl(var(--primary) / 0.16), transparent 68%),
      radial-gradient(700px 400px at 92% 18%, hsl(25 80% 60% / 0.1), transparent 62%),
      radial-gradient(650px 380px at 8% 20%, hsl(20 73% 65% / 0.11), transparent 62%),
      var(--bg);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.32;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  /* animated ember layer */
  .hero::after {
    content: "";
    position: absolute;
    inset: -15%;
    background:
      radial-gradient(500px 380px at 50% 0%, hsl(var(--primary) / 0.14), transparent 65%),
      radial-gradient(420px 320px at 10% 15%, hsl(20 73% 65% / 0.13), transparent 60%);
    filter: blur(22px);
    opacity: 0.9;
    animation: hero-breathe 14s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes hero-breathe {
    0% { transform: translate3d(-1.5%, -0.8%, 0) scale(1); opacity: 0.75; }
    100% { transform: translate3d(2.2%, 1.2%, 0) scale(1.08); opacity: 1; }
  }
  .hero::after { animation: hero-breathe 7s ease-in-out infinite alternate; }
  .hero > .shell { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) { .hero::after { animation: none; } }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.1rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.6875rem;
    color: var(--mut);
  }
  .pulse {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 0 hsl(var(--primary) / 0.6);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    70%,
    100% {
      box-shadow: 0 0 0 0.4rem transparent;
    }
  }
  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.1rem, 5.4vw, 3.4rem);
    font-weight: 640;
    line-height: 1.07;
    letter-spacing: -0.032em;
  }
  .lede {
    max-width: 36rem;
    margin: 0 auto 1.9rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--mut);
  }
  .lede b {
    color: var(--fg);
    font-weight: 600;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .micro {
    margin: 0;
    font-size: 0.75rem;
    color: var(--faint);
  }
  .micro code {
    color: var(--mut);
  }

  .hero { padding-bottom: 2.5rem; }
  .demo-wrap {
    margin-top: 3.25rem;
  }
  .demo-cap {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--faint);
    text-align: center;
  }

  /* ---- harness strip ---- seamless: transparent, margin not padded bg */
  .strip {
    margin-top: 0;
    padding-block: 0;
    border-top: 1px solid hsl(var(--border) / 0.22);
    border-bottom: 1px solid hsl(var(--border) / 0.22);
    background: transparent;
  }
  .strip-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }
  .strip-label {
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .strip-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip-logos li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--mut);
  }
  .strip-logos img {
    width: 1.125rem;
    height: 1.125rem;
    object-fit: contain;
    opacity: 0.9;
  }

  /* ---- spec sheet ---- */
  .specs {
    border-bottom: 1px solid var(--line);
    padding-block: 3rem;
  }
  /* Five columns of answer-then-caption. No rules between them and no boxes:
     the section already has its own separator, so cell borders only doubled
     it and turned a row of facts back into the datasheet it replaced. Space
     does the dividing. */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.5rem;
    margin: 0;
  }
  @media (min-width: 720px) {
    .spec-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .spec {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  /* An odd count leaves a gap in the two-column phone layout; let the last
     cell take the full row instead of trailing an empty one. */
  @media (max-width: 719px) {
    .spec:last-child {
      grid-column: 1 / -1;
    }
  }
  .spec dt {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: hsl(var(--primary));
    line-height: 1;
  }
  .spec dd {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--mut);
  }

  /* ---- close ---- */
  .close {
    padding-block: 5.5rem;
  }
  .close-in {
    text-align: center;
  }
  .close h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 4.4vw, 2.7rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .close > .shell > p {
    margin: 0 0 1.7rem;
    color: var(--mut);
  }
  .cta-center {
    justify-content: center;
  }

  /* ---- footer ---- */
  .foot {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }
  .foot-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  @media (min-width: 620px) {
    .foot-in {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .logo-sm {
    color: var(--mut);
  }
  .foot nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .pulse {
      transition: none;
      animation: none;
    }
  }
</style>
