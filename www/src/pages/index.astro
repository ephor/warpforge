---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import { config } from "virtual:nimbus/config";

const agents = [
  { name: "Claude Code", cmd: "claude-agent-acp --acp", logo: "/logos/claude-ai-icon.svg" },
  { name: "Codex", cmd: "codex-acp", logo: "/logos/codex_dark.svg" },
  { name: "OpenCode", cmd: "opencode acp", logo: "/logos/openCode_dark.svg" },
  { name: "Qwen Code", cmd: "qwen --acp", logo: "/logos/qwen_dark.svg" },
  { name: "Goose", cmd: "goose acp", logo: "/logos/goose_dark.png" },
  { name: "Junie", cmd: "junie --acp true", logo: "/logos/junie.svg" },
  { name: "Cursor", cmd: "cursor-agent-acp", logo: "/logos/cursor_dark.svg" },
  { name: "Pi", cmd: "pi-acp", logo: "/logos/pi_dark.svg" },
];

const drafted = [
  {
    icon: "ph:tag",
    title: "Task titles",
    body: "Drop a rough prompt in — a short, imperative title shows up on the task within seconds. Nothing to name yourself.",
  },
  {
    icon: "ph:git-commit",
    title: "Commit messages",
    body: "Conventional Commits, written from the actual diff, not the prompt. Edit before you commit, or don't.",
  },
  {
    icon: "ph:git-pull-request",
    title: "Pull request descriptions",
    body: "Title and Markdown body drafted from the branch's outgoing commits and their combined diff.",
  },
];

const features = [
  {
    icon: "ph:squares-four",
    title: "Mission Control for active work",
    body: "Running, blocked, interrupted, and review-ready sessions across every project, with live conversation previews.",
  },
  {
    icon: "ph:tree-structure",
    title: "One task, several harnesses",
    body: "The orchestrator can spawn Claude Code, Codex, and OpenCode sub-agents in the same task and track every result — no other tool coordinates across harnesses like this.",
    featured: true,
  },
  {
    icon: "ph:code",
    title: "An editor, not just a diff",
    body: "Full file tree, CodeMirror syntax highlighting, inline edits — read and fix code without leaving the task.",
  },
  {
    icon: "ph:arrow-counter-clockwise",
    title: "Every task remembers where it left off",
    body: "Close the app, restart the daemon, come back tomorrow — the conversation and task history are still there.",
  },
  {
    icon: "ph:flow-arrow",
    title: "Repeatable workflows, not just a prompt",
    body: "Plan, implement, review, and fix as explicit stages, each on its own agent and model. The daemon drives the transitions — not a manager LLM — and stops for a human decision at the review limit.",
    featured: true,
  },
  {
    icon: "ph:git-branch",
    title: "Parallel work, no checkout collisions",
    body: "A task can run in its own git worktree while staying attached to the same project.",
  },
  {
    icon: "ph:path",
    title: "The environment travels with the task",
    body: "Agents get live service URLs, resolved ports, and project context instead of guessing how to run the app.",
  },
  {
    icon: "ph:hand-palm",
    title: "Human control at the moments that matter",
    body: "Permission requests, commands, tool calls, and diffs stay visible before anything moves forward.",
  },
];
---

<!doctype html>
<html lang={config.locale ?? "en"} data-wf-landing>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <NimbusHead title={config.title} description={config.description} />
  </head>
  <body>
    <div class="wf">
      <!-- Nav -->
      <header class="wf-nav">
        <div class="wf-shell wf-nav-inner">
          <a href="/" class="wf-logo">
            <span class="wf-logo-mark" aria-hidden="true"></span>
            Warpforge
          </a>
          <nav class="wf-nav-links" aria-label="Primary">
            <a href="#agents">Agents</a>
            <a href="#workflow">Workflow</a>
            <a href="/getting-started/install/">Docs</a>
          </nav>
          <div class="wf-nav-actions">
            <a
              href={config.github ?? "https://github.com/ephor/warpforge"}
              class="wf-icon-btn"
              aria-label="GitHub"
              target="_blank"
              rel="noopener"
            >
              <Icon name="ph:github-logo" size={18} />
            </a>
            <a href="https://github.com/ephor/warpforge/releases/latest" class="wf-btn wf-btn-primary wf-btn-sm">
              Download
            </a>
          </div>
        </div>
      </header>

      <main id="main-content">
        <!-- Hero -->
        <section class="wf-hero">
          <div class="wf-dotgrid" aria-hidden="true"></div>
          <div class="wf-shell wf-hero-inner">
            <p class="wf-eyebrow">
              <Icon name="ph:check-circle" size={14} />
              Open source · Local-first · macOS
            </p>
            <h1 class="wf-h1">One task, every harness,<br />one place to review it.</h1>
            <p class="wf-sub">
              Warpforge is an <strong>agentic development environment</strong>: orchestrator, project
              runtime, and review surface in one local app — not a wrapper around a single model.
              Claude Code, Codex, and OpenCode still do the coding; Warpforge is where you run,
              coordinate, and review all of it.
            </p>
            <div class="wf-cta-row wf-center">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="wf-btn wf-btn-primary wf-btn-lg">
                <Icon name="ph:apple-logo" size={18} />
                Download for macOS
              </a>
              <a href="/getting-started/install/" class="wf-btn wf-btn-ghost wf-btn-lg">
                Read the docs
                <Icon name="ph:arrow-right" size={16} />
              </a>
            </div>
            <p class="wf-microcopy">Apple Silicon · Signed &amp; notarized · No Warpforge account, ever</p>
          </div>

          <div class="wf-shell wf-hero-shot-wrap">
            <div class="wf-glow" aria-hidden="true"></div>
            <div class="wf-window">
              <div class="wf-window-bar">
                <span class="wf-dot wf-dot-r"></span>
                <span class="wf-dot wf-dot-y"></span>
                <span class="wf-dot wf-dot-g"></span>
                <span class="wf-window-title">Warpforge — Implement Expo Mobile</span>
              </div>
              <img
                src="/images/task-detail.png"
                alt="Warpforge task view: agent conversation, live diff, and staged changes"
                width="2000"
                height="1255"
                loading="eager"
              />
            </div>
          </div>
        </section>

        <!-- Agents -->
        <section class="wf-section" id="agents">
          <div class="wf-shell">
            <p class="wf-eyebrow wf-eyebrow-center">Bring your own agents</p>
            <h2 class="wf-h2 wf-center">Works with the agents you already run.</h2>
            <p class="wf-sub wf-center">
              No new account, no new API key. Warpforge finds the binaries already on your{" "}
              <code>PATH</code> and speaks ACP to them — your existing login just works.
            </p>

            <div class="wf-agent-grid">
              {
                agents.map((agent) => (
                  <div class="wf-agent-card">
                    <span class="wf-agent-logo">
                      <img src={agent.logo} alt="" width="20" height="20" loading="lazy" />
                    </span>
                    <div>
                      <div class="wf-agent-name">{agent.name}</div>
                      <div class="wf-agent-cmd">{agent.cmd}</div>
                    </div>
                  </div>
                ))
              }
            </div>

            <ul class="wf-checkline">
              <li><Icon name="ph:check-circle" size={16} />Your existing login, reused</li>
              <li><Icon name="ph:check-circle" size={16} />One-click install &amp; update</li>
              <li><Icon name="ph:check-circle" size={16} />Any ACP-compatible agent, custom command</li>
            </ul>
          </div>
        </section>

        <!-- Drafted for you -->
        <section class="wf-section">
          <div class="wf-shell">
            <p class="wf-eyebrow wf-eyebrow-center">Nothing left blank</p>
            <h2 class="wf-h2 wf-center">Drafted for you, not typed by you.</h2>
            <p class="wf-sub wf-center">
              Three things every workflow makes you write by hand, that Warpforge writes for you —
              you stay the editor, not the author.
            </p>
            <div class="wf-drafted-grid">
              {
                drafted.map((d) => (
                  <div class="wf-feature-card">
                    <div class="wf-feature-icon">
                      <Icon name={d.icon} size={20} />
                    </div>
                    <h3>{d.title}</h3>
                    <p>{d.body}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <!-- Review split -->
        <section class="wf-section" id="workflow">
          <div class="wf-shell wf-split">
            <div class="wf-shot-wrap">
              <div class="wf-glow wf-glow-sm" aria-hidden="true"></div>
              <div class="wf-window wf-window-small wf-window-minimal">
                <div class="wf-window-bar">
                  <span class="wf-window-title wf-window-title-left">Pipeline — implement → review ⇄ fix</span>
                </div>
                <img
                  src="/images/workflow-pipeline-crop.png"
                  alt="Workflow pipeline stages (implement, reviewer) marked done, with the reviewer's verdict and check results"
                  width="940"
                  height="660"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="wf-split-copy">
              <h2 class="wf-h2">From agent output to a reviewed branch.</h2>
              <p class="wf-sub wf-sub-left">
                Unified or split diffs, hunk-level accept/reject, inline edits — review happens in the
                same workspace the agent worked in, not a separate tab you have to remember to check.
              </p>
              <ul class="wf-checklist">
                <li><Icon name="ph:check-circle" size={18} />Hunk-level accept / reject, inline edits</li>
                <li><Icon name="ph:check-circle" size={18} />Commit, amend, push with <code>--force-with-lease</code></li>
                <li><Icon name="ph:check-circle" size={18} />Open a pull request from the same workspace</li>
                <li><Icon name="ph:check-circle" size={18} />A completed workflow never commits on its own</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Feature grid -->
        <section class="wf-section wf-section-spine">
          <div class="wf-shell">
            <p class="wf-eyebrow wf-eyebrow-center">Why Warpforge</p>
            <p class="wf-spine">
              Other tools give you an agent, or a diff viewer, or a task board. Warpforge is
              the <span class="wf-spine-accent">orchestrator</span>, the <span class="wf-spine-accent">runtime</span>,
              and the <span class="wf-spine-accent">review surface</span> — in one local app.
            </p>
            <div class="wf-feature-grid">
              {
                features.map((f) => (
                  <div class:list={["wf-feature-card", f.featured && "wf-feature-card-featured"]}>
                    <div class="wf-feature-icon">
                      <Icon name={f.icon} size={f.featured ? 24 : 20} />
                    </div>
                    <h3>{f.title}</h3>
                    <p>{f.body}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </section>

        <!-- CLI / ownership split -->
        <section class="wf-section">
          <div class="wf-shell wf-split wf-split-reverse">
            <div class="wf-split-copy">
              <h2 class="wf-h2">Yours. Runs on your machine.</h2>
              <p class="wf-sub wf-sub-left">
                A local Rust daemon owns projects, services, and task state. No cloud account, no
                telemetry you didn't ask for, no third party in the loop between your agent and your
                code.
              </p>
              <ul class="wf-checklist">
                <li><Icon name="ph:check-circle" size={18} />Predictable 100-port range per project, no <code>address already in use</code></li>
                <li><Icon name="ph:check-circle" size={18} /><code>.warpforge/workspace.yaml</code> travels with the repo, not one person's settings</li>
                <li><Icon name="ph:check-circle" size={18} />MIT licensed, built in the open</li>
              </ul>
              <div class="wf-cta-row">
                <a href="https://github.com/ephor/warpforge" class="wf-btn wf-btn-secondary" target="_blank" rel="noopener">
                  <Icon name="ph:github-logo" size={16} />
                  View source
                </a>
                <a href="/reference/configuration/" class="wf-btn wf-btn-ghost">
                  Config reference
                  <Icon name="ph:arrow-right" size={16} />
                </a>
              </div>
            </div>
            <div class="wf-window wf-window-small wf-window-minimal wf-terminal">
              <div class="wf-window-bar">
                <span class="wf-window-title wf-window-title-left">~/code/my-app</span>
              </div>
              <pre class="wf-term"><code><span class="wf-term-prompt">$</span> warpforge add ~/code/my-app
<span class="wf-term-out">✓ registered my-app · ports 4000–4099</span>

<span class="wf-term-prompt">$</span> warpforge list
<span class="wf-term-out">my-app     4000–4099   2 services running
lingoverse 4100–4199   1 service running</span>

<span class="wf-term-prompt">$</span> <span class="wf-term-cursor">&nbsp;</span></code></pre>
            </div>
          </div>
        </section>

        <!-- Final CTA -->
        <section class="wf-cta-band">
          <div class="wf-glow wf-glow-band" aria-hidden="true"></div>
          <div class="wf-shell wf-cta-band-inner">
            <h2 class="wf-h1 wf-h1-tight">Stop babysitting agent panes.<br />Start reviewing one diff.</h2>
            <p class="wf-sub wf-center">Free, open source, and it runs entirely on your machine.</p>
            <div class="wf-cta-row wf-center">
              <a href="https://github.com/ephor/warpforge/releases/latest" class="wf-btn wf-btn-primary wf-btn-lg">
                <Icon name="ph:apple-logo" size={18} />
                Download for macOS
              </a>
              <a href="/getting-started/install/" class="wf-btn wf-btn-ghost wf-btn-lg">Read the docs</a>
            </div>
            <p class="wf-microcopy">Apple Silicon today · Windows &amp; Linux packaging is an opt-in preview</p>
          </div>
        </section>
      </main>

      <!-- Footer -->
      <footer class="wf-footer">
        <div class="wf-shell wf-footer-inner">
          <a href="/" class="wf-logo wf-logo-sm">
            <span class="wf-logo-mark" aria-hidden="true"></span>
            Warpforge
          </a>
          <nav class="wf-footer-links" aria-label="Footer">
            <a href="/getting-started/install/">Docs</a>
            <a href="https://github.com/ephor/warpforge" target="_blank" rel="noopener">GitHub</a>
            <a href="https://github.com/ephor/warpforge/blob/main/CHANGELOG.md" target="_blank" rel="noopener">Changelog</a>
            <a href="https://github.com/ephor/warpforge/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  /* ============================================================
   * Landing-only palette. Matches the real desktop app's theme
   * (see desktop/src/globals.css: warm near-black + peach accent),
   * fixed dark regardless of the docs site's light/dark toggle —
   * this page doesn't render the docs chrome or ThemeToggle.
   * ============================================================ */
  .wf {
    --wf-bg: #141514;
    --wf-bg-soft: #171816;
    --wf-card: #1c1d1b;
    --wf-card-hover: #222320;
    --wf-fg: #ede9e3;
    --wf-fg-muted: #a59f97;
    --wf-fg-faint: #726c64;
    --wf-accent: #eaa07b;
    --wf-accent-hover: #e3804f;
    --wf-accent-ink: #2a1509;
    --wf-border: #343630;
    --wf-border-soft: #26271f;

    background: var(--wf-bg);
    color: var(--wf-fg);
    font-family: "Inter Variable", "Inter", system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  .wf-shell {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  code {
    font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
  }

  /* ---- Nav ---- */
  .wf-nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--wf-border-soft);
    background: color-mix(in oklch, var(--wf-bg) 85%, transparent);
    backdrop-filter: blur(10px);
  }
  .wf-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .wf-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--wf-fg);
    text-decoration: none;
  }
  .wf-logo-mark {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--wf-accent);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
  .wf-nav-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.875rem;
    color: var(--wf-fg-muted);
  }
  .wf-nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .wf-nav-links a:hover {
    color: var(--wf-fg);
  }
  @media (min-width: 768px) {
    .wf-nav-links {
      display: flex;
    }
  }
  .wf-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wf-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    color: var(--wf-fg-muted);
    transition: all 0.15s ease;
  }
  .wf-icon-btn:hover {
    color: var(--wf-fg);
    background: var(--wf-card);
  }

  /* ---- Buttons ---- */
  .wf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.625rem;
    font-weight: 550;
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }
  .wf-btn-primary {
    background: var(--wf-accent);
    color: var(--wf-accent-ink);
  }
  .wf-btn-primary:hover {
    background: var(--wf-accent-hover);
    transform: translateY(-1px);
  }
  .wf-btn-secondary {
    background: var(--wf-card);
    color: var(--wf-fg);
    border-color: var(--wf-border);
  }
  .wf-btn-secondary:hover {
    background: var(--wf-card-hover);
    border-color: var(--wf-fg-faint);
  }
  .wf-btn-ghost {
    background: transparent;
    color: var(--wf-fg-muted);
  }
  .wf-btn-ghost:hover {
    color: var(--wf-fg);
  }
  .wf-btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }
  .wf-btn-lg {
    padding: 0.75rem 1.375rem;
    font-size: 0.9375rem;
    border-radius: 0.75rem;
  }

  /* ---- Dot-grid texture ---- */
  .wf-dotgrid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--wf-border) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, black 40%, transparent 90%);
    mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, black 40%, transparent 90%);
    opacity: 0.6;
    pointer-events: none;
  }

  /* ---- Hero ---- */
  .wf-hero {
    position: relative;
    padding-top: 5rem;
    overflow: hidden;
  }
  .wf-hero-inner {
    position: relative;
    text-align: center;
    max-width: 44rem;
  }
  .wf-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 1.25rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--wf-border);
    background: var(--wf-bg-soft);
    color: var(--wf-fg-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .wf-eyebrow-center {
    justify-content: center;
  }
  .wf-eyebrow :global(svg) {
    color: var(--wf-accent);
  }
  .wf-h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--wf-fg);
  }
  .wf-h1-tight {
    margin-bottom: 1rem;
  }
  .wf-h2 {
    margin: 0 0 0.875rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--wf-fg);
  }
  .wf-sub {
    margin: 0 auto 1.75rem;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--wf-fg-muted);
  }
  .wf-sub strong {
    color: var(--wf-fg);
    font-weight: 600;
  }
  .wf-sub-left {
    margin-inline: 0;
  }
  .wf-center {
    text-align: center;
  }
  .wf-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
  }
  .wf-cta-row.wf-center {
    justify-content: center;
  }
  .wf-microcopy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--wf-fg-faint);
  }

  /* ---- Window / screenshot frame ---- */
  .wf-hero-shot-wrap {
    position: relative;
    margin-top: 3.5rem;
    max-width: 62rem;
  }
  .wf-glow {
    position: absolute;
    inset: -10% 8% auto 8%;
    height: 60%;
    background: radial-gradient(ellipse at center, color-mix(in oklch, var(--wf-accent) 28%, transparent), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .wf-glow-sm {
    inset: -15% 15% auto 15%;
    height: 50%;
    background: radial-gradient(ellipse at center, color-mix(in oklch, var(--wf-accent) 16%, transparent), transparent 70%);
    filter: blur(32px);
  }
  .wf-glow-band {
    inset: -20% 20% auto 20%;
    height: 70%;
    background: radial-gradient(ellipse at center, color-mix(in oklch, var(--wf-accent) 14%, transparent), transparent 72%);
  }
  .wf-shot-wrap {
    position: relative;
  }
  .wf-window {
    position: relative;
    border-radius: 0.875rem;
    border: 1px solid var(--wf-border);
    background: var(--wf-card);
    overflow: hidden;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55);
  }
  .wf-window img {
    display: block;
    width: 100%;
    height: auto;
  }
  .wf-window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--wf-border-soft);
    background: var(--wf-bg-soft);
  }
  .wf-dot {
